{
  "name": "start-back",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names REDIS,FRONTEND,BACKEND,WORKER --prefix-colors red,blue,green,magenta \"docker compose up redis\" \"npm run dev --workspace @start-back/frontend\" \"npm run dev --workspace @start-back/backend\" \"npm run worker --workspace @start-back/backend\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint apps --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:types": "npm run db:types --workspace @start-back/backend"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "postcss-selector-parser": "^7.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.6.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
