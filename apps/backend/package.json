{
  "name": "@start-back/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "worker": "node --env-file-if-exists=../../.env --import tsx src/worker.ts",
    "wiki:retitular": "node --env-file-if-exists=../../.env --import tsx src/scripts/retitular-wiki.ts",
    "storage:migrar": "node --env-file-if-exists=../../.env --import tsx src/scripts/migrar-b2.ts",
    "build": "node scripts/build-worker.mjs && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit --pretty false",
    "db:types": "supabase gen types typescript --linked --schema tutoriais > src/integrations/supabase/database.types.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/sandbox": "^3.6.1",
    "bullmq": "^6.3.12",
    "esbuild": "^0.28.2",
    "ioredis": "^6.0.0",
    "next": "^16.3.8",
    "openai": "^7.31.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "workflow": "^5.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "supabase": "^2.119.0",
    "typescript": "^5.9.3"
  }
}
