# Supabase — Project Settings > API
START_BACK_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
START_BACK_SUPABASE_ANON_KEY=COLE_A_CHAVE_PUBLICA_AQUI
START_BACK_SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY_AQUI
START_BACK_SUPABASE_PROJECT_ID=SEU_PROJECT_ID

# Aplicação
START_BACK_ALLOWED_ORIGINS=http://localhost:8081
START_BACK_APP_PORT=8081
# Se trocar a porta, inclua a origem exata em START_BACK_ALLOWED_ORIGINS.
START_BACK_DOWNLOAD_SECRET=GERE_UMA_STRING_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
START_BACK_MAX_VIDEO_BYTES=524288000
START_BACK_MAX_VIDEO_DURATION_MS=900000
START_BACK_UPLOAD_CHUNK_BYTES=5242880

# OpenAI — somente servidor/worker
OPENAI_API_KEY=COLE_A_CHAVE_OPENAI_AQUI
START_BACK_OPENAI_MODEL=gpt-6.1-sol
START_BACK_MAX_ANALYSIS_FRAMES=120
FISH_API_KEY=
FISH_VOICE_ID_PRIMARY=
FISH_VOICE_ID=
START_BACK_FISH_MODEL=s2.1-pro-free
START_BACK_FISH_CONCURRENCY=2

# Frontend local (valor público, nunca coloque secrets em VITE_*)
VITE_API_URL=
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_A_CHAVE_PUBLICA_AQUI
VITE_POMINSAC_SUPABASE_URL=https://dwbmfcvvlbjejyyodtol.supabase.co
VITE_POMINSAC_SUPABASE_ANON_KEY=COLE_A_CHAVE_PUBLICA_DO_POMINSAC_AQUI
VITE_POMINSAC_ATTACHMENT_TOKEN=COLE_O_TOKEN_DE_ANEXOS_DO_POMINSAC_AQUI

